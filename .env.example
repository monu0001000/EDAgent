GEMINI_API_KEY=your-free-gemini-api-key-here

# Optional: override the default Gemini model (gemini-flash-latest). Useful
# if that model's free-tier quota runs out — run list_models.py to see what
# your key can access, then set e.g.:
# GEMINI_MODEL=gemini-2.5-flash

# Optional but recommended: also set a Groq key as a second option. Groq's
# free tier allows more requests per minute than Gemini's, which helps
# since the agentic mode makes several calls in quick succession. Get a
# free key (no credit card) at https://console.groq.com/keys
GROQ_API_KEY=your-free-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
